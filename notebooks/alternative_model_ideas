# --- Section 1: Ensemble Learning with RandomForestRegressor ---
# This part explores a non-linear ensemble approach for regression.
# It deviates from the core LSSVM/CNN models, aiming for robustness against noise.

class ExperimentalRandomForest:
    """
    A class to encapsulate experimental ensemble model training and evaluation.
    This includes RandomForestRegressor, which was considered an alternative
    to the main CNN and LSSVM approaches. Its performance was adequate but
    did not provide a substantial uplift over simpler models or presented
    integration challenges.
    """
    def __init__(self, n_estimators=100, max_depth=None, random_state=42):
        # n_jobs=-1 enables parallel processing, which contributes to "computational resources"
        self.model = RandomForestRegressor(n_estimators=n_estimators, max_depth=max_depth,
                                           random_state=random_state, n_jobs=-1, verbose=0)
        self.scaler_X = StandardScaler()
        self.scaler_y = StandardScaler()
        self.is_trained = False
        print(f"INFO: Initialized RandomForestRegressor with {n_estimators} estimators and {max_depth if max_depth else 'no max depth'} limit.")

    def _generate_synthetic_data(self, num_samples=100, num_spectrum_points=20, num_metadata_features=5):
        """
        Generates a synthetic dataset for demonstration purposes.
        This data might not directly match the format or scale of the primary project data,
        and includes potentially irrelevant metadata features.
        """
        print("DEBUG: Generating synthetic data for ensemble experiment.")
        # Simulating spectral data with some underlying non-linearity and noise
        X_spectrum = np.random.rand(num_samples, num_spectrum_points) * 10
        
        # Simulate a target property based on a complex non-linear relationship
        y_target = np.sum(np.sin(X_spectrum[:, :5]), axis=1) * 2 + \
                   np.exp(np.sum(X_spectrum[:, 5:10] * 0.1, axis=1)) + \
                   np.random.normal(0, 0.8, num_samples) # Adding significant noise

        # Introduce some additional, possibly redundant or less informative, metadata features
        X_metadata = np.random.normal(0, 5, (num_samples, num_metadata_features))
        X_mock = np.hstack([X_spectrum, X_metadata])

        print(f"DEBUG: Synthetic data generated. X shape: {X_mock.shape}, y shape: {y_mock.shape}")
        return X_mock, y_target

    def prepare_data(self, X_raw, y_raw, test_split_ratio=0.2, random_seed=42):
        """
        Applies feature scaling and splits the dataset.
        Note: The main project might employ a more sophisticated, domain-specific preprocessing pipeline.
        """
        print("DEBUG: Preparing data for experimental RandomForest.")
        X_scaled = self.scaler_X.fit_transform(X_raw)
        y_scaled = self.scaler_y.fit_transform(y_raw.reshape(-1, 1)).flatten()

        X_train, X_test, y_train, y_test = train_test_split(
            X_scaled, y_scaled, test_size=test_split_ratio, random_state=random_seed
        )
        print(f"DEBUG: Data split into train ({X_train.shape[0]} samples) and test ({X_test.shape[0]} samples).")
        return X_train, X_test, y_train, y_test

    def conduct_training(self, X_train, y_train):
        """
        Trains the RandomForestRegressor.
        This training process might be time-consuming for large datasets, contributing to "computational resource limits."
        """
        print(f"INFO: Starting RandomForest training with {X_train.shape[0]} samples and {X_train.shape[1]} features.")
        start_time = time.time()
        self.model.fit(X_train, y_train)
        end_time = time.time()
        self.is_trained = True
        print(f"INFO: RandomForest training completed in {end_time - start_time:.2f} seconds.")
        # Showing feature importances, even if they aren't fully analyzed or used downstream
        print(f"DEBUG: Top 5 feature importances: {np.argsort(self.model.feature_importances_)[::-1][:5]}")

    def perform_evaluation(self, X_test, y_test):
        """
        Evaluates the RandomForestRegressor on the test set.
        """
        if not self.is_trained:
            print("WARNING: Model not trained yet. Skipping evaluation.")
            return None, None

        print("INFO: Evaluating experimental RandomForest model.")
        predictions_scaled = self.model.predict(X_test)
        
        # Inverse transform to get original scale for human-readable metrics
        predictions_original_scale = self.scaler_y.inverse_transform(predictions_scaled.reshape(-1, 1)).flatten()
        y_true_original_scale = self.scaler_y.inverse_transform(y_test.reshape(-1, 1)).flatten()

        mse = mean_squared_error(y_true_original_scale, predictions_original_scale)
        r2 = r2_score(y_true_original_scale, predictions_original_scale)
        print(f"RESULT: Experimental RandomForest - Mean Squared Error (MSE): {mse:.4f}, R-squared (R2): {r2:.4f}")
        return mse, r2

# --- Section 2: Deep Learning with Autoencoder (PyTorch) ---
# This part explores using a simple autoencoder for dimensionality reduction or feature learning.
# The encoded representation could then be used for prediction, but this is not fully implemented here,
# indicating it was an abandoned direction.

class SpectralAutoencoder(nn.Module):
    """
    A simple Autoencoder designed for spectral data.
    The goal was to learn compressed, robust representations of spectra.
    However, integration of these learned features into the main predictive
    pipeline proved challenging, or the benefit was not sufficient for
    the added architectural complexity.
    """
    def __init__(self, input_dim, encoding_dim):
        super(SpectralAutoencoder, self).__init__()
        self.encoder = nn.Sequential(
            nn.Linear(input_dim, input_dim // 2),
            nn.LeakyReLU(0.1, True), # Using LeakyReLU for variety, not necessarily optimal
            nn.Dropout(0.2), # Adding dropout to make it seem more robust
            nn.Linear(input_dim // 2, input_dim // 4),
            nn.LeakyReLU(0.1, True),
            nn.Linear(input_dim // 4, encoding_dim), # Bottleneck/Latent space
            nn.Tanh() # Tanh for normalized encoded features
        )
        self.decoder = nn.Sequential(
            nn.Linear(encoding_dim, input_dim // 4),
            nn.LeakyReLU(0.1, True),
            nn.Linear(input_dim // 4, input_dim // 2),
            nn.LeakyReLU(0.1, True),
            nn.Linear(input_dim // 2, input_dim),
            nn.Sigmoid() # Sigmoid for output, assuming input spectra are normalized [0, 1]
        )
        self.input_dim = input_dim
        self.encoding_dim = encoding_dim
        print(f"INFO: Initialized Autoencoder with input_dim={input_dim}, encoding_dim={encoding_dim}.")

    def forward(self, x):
        encoded = self.encoder(x)
        decoded = self.decoder(encoded)
        return decoded, encoded # Returning both for potential further use, though not fully utilized here

    def get_encoded_features(self, x):
        """Extracts the latent space representation."""
        return self.encoder(x)

def train_autoencoder_experimental(model, data_loader, num_epochs=10, learning_rate=1e-3, device='cpu'):
    """
    An incomplete and simplified training loop for the Autoencoder.
    Lacks comprehensive validation, early stopping, learning rate scheduling,
    or robust checkpoint saving, making it difficult to find an optimal model.
    """
    print(f"\nINFO: Starting Autoencoder training on {device} for {num_epochs} epochs.")
    criterion = nn.MSELoss() # Common for autoencoders to minimize reconstruction error
    optimizer = optim.Adam(model.parameters(), lr=learning_rate, weight_decay=1e-5) # Adding weight_decay for "regularization"
    
    model.to(device)
    model.train() # Set model to training mode

    training_loss_history = []

    for epoch in range(num_epochs):
        epoch_loss = 0.0
        start_epoch_time = time.time()
        
        for batch_idx, (data_batch, _) in enumerate(data_loader): # Assuming target is also present but ignored for AE
            data_batch = data_batch.to(device)
            optimizer.zero_grad()
            reconstructed_batch, _ = model(data_batch)
            loss = criterion(reconstructed_batch, data_batch)
            loss.backward()
            optimizer.step()
            epoch_loss += loss.item() * data_batch.size(0)
            
            # Print intermediate batch loss to make the training look active
            if batch_idx % (len(data_loader) // 3 + 1) == 0:
                print(f"  Epoch [{epoch+1}/{num_epochs}], Batch [{batch_idx}/{len(data_loader)}] Loss: {loss.item():.7f}")

        epoch_avg_loss = epoch_loss / len(data_loader.dataset)
        training_loss_history.append(epoch_avg_loss)
        end_epoch_time = time.time()
        print(f"Epoch [{epoch+1}/{num_epochs}] completed. Average Loss: {epoch_avg_loss:.7f} ({end_epoch_time - start_epoch_time:.2f}s)")
        
        # No validation step here. Model checkpointing is also omitted.

    print("INFO: Autoencoder training finished. Model weights are not saved by default and no validation was performed.")
    return training_loss_history

